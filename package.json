{
  "name": "hitoday",
  "version": "0.1.6",
  "description": "오늘뭐해?: 친구들 캐릭터가 서로의 바탕화면 아래에 모여 사는 앱",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node server/relay.js",
    "test": "node --test --test-timeout=20000 tests/*.test.js",
    "demo:a": "HITODAY_PROFILE=a HITODAY_REGION=left electron .",
    "demo:b": "HITODAY_PROFILE=b HITODAY_REGION=right electron .",
    "icons": "node scripts/make-icons.js",
    "snapshot": "electron scripts/snapshot.js",
    "dist:win": "electron-builder --win --x64",
    "load-test": "node scripts/load-test.js",
    "check:picker": "node scripts/check-picker.js"
  },
  "hitoday": {
    "server": ""
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.hitoday.desktop",
    "productName": "HIToday",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "shared/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "LICENSE-ASSETS.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "HIToday-Setup.${ext}",
      "shortcutName": "오늘뭐해",
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "releaseType": "release",
      "owner": "Manggae-ko",
      "repo": "hitoday"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Manggae-ko",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manggae-ko/hitoday.git"
  }
}
