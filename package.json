{
  "name": "jakdang",
  "version": "0.1.4",
  "description": "작당모의: 친구들 캐릭터가 서로의 바탕화면 아래에 모여 사는 앱",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "server": "node server/relay.js",
    "test": "node --test --test-timeout=20000 tests/*.test.js",
    "demo:a": "JAKDANG_PROFILE=a JAKDANG_REGION=left electron .",
    "demo:b": "JAKDANG_PROFILE=b JAKDANG_REGION=right electron .",
    "icons": "node scripts/make-icons.js",
    "snapshot": "electron scripts/snapshot.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "load-test": "node scripts/load-test.js",
    "check:picker": "node scripts/check-picker.js"
  },
  "jakdang": {
    "server": ""
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.jakdang.desktop",
    "productName": "Jakdang",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "shared/**",
      "assets/**",
      "package.json",
      "LICENSE",
      "LICENSE-ASSETS.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Jakdang-mac-${arch}.${ext}",
      "category": "public.app-category.social-networking",
      "extendInfo": {
        "LSUIElement": true,
        "CFBundleDisplayName": "Jakdang",
        "LSHasLocalizedDisplayName": true
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/mac-locales/ko.lproj",
          "to": "ko.lproj"
        },
        {
          "from": "build/mac-locales/en.lproj",
          "to": "en.lproj"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "Jakdang-Setup.${ext}",
      "shortcutName": "작당모의",
      "oneClick": true,
      "perMachine": false
    },
    "publish": {
      "provider": "github",
      "releaseType": "release",
      "owner": "donghyeun02",
      "repo": "jakdang"
    },
    "dmg": {
      "format": "ULFO"
    }
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "naego works",
  "repository": {
    "type": "git",
    "url": "https://github.com/donghyeun02/jakdang.git"
  }
}
