# Copy to deploy/.env on the server and fill in.

# The address people and apps use. Its DNS A record must point at this server.
DOMAIN=jakdang.naegoworks.com

# GitHub repo whose latest Release the download buttons point at (owner/name).
GITHUB_REPO=donghyeun02/jakdang

# Google Analytics 4 measurement id for the download page (G-XXXXXXXXXX). Empty = off.
GA_MEASUREMENT_ID=

# Password for https://<DOMAIN>/stats (at least 16 characters). Empty = stats page off.
# Make one with:  openssl rand -hex 24
STATS_TOKEN=
